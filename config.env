# ── Edit these, then run ./setup.sh ────────────────────────────────────────────

# AWS region where the EKS cluster and the Bedrock VPC endpoints live
export REGION="ap-southeast-1"

# Name of the EKS cluster (as shown by: aws eks list-clusters --region $REGION)
export CLUSTER_NAME="CHANGE-ME"

# AWS CLI profile to use (leave empty to use the default profile / env creds)
export AWS_PROFILE_NAME=""

# Kubernetes namespace + names the test objects are created in
export NAMESPACE="bedrock-test"
export SA_NAME="bedrock-test-sa"
export POD_NAME="bedrock-endpoint-test"

# IAM role for IRSA. Leave as-is and ./iam/setup-irsa.sh will create it,
# or point it at a role you already have.
export ROLE_NAME="eks-bedrock-endpoint-test"

# Model used for the real InvokeModel/Converse call.
# APAC cross-region inference profile — list yours with:
#   aws bedrock list-inference-profiles --region $REGION
export MODEL_ID="apac.anthropic.claude-sonnet-5"

# Test image (Amazon Linux 2023 + AWS CLI v2). The node must be able to pull it:
# either via NAT/IGW or via com.amazonaws.$REGION.ecr.api / .ecr.dkr / s3 endpoints.
export TEST_IMAGE="public.ecr.aws/aws-cli/aws-cli:latest"
